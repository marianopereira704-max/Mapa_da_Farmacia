# Modelo de .streamlit/secrets.toml — copie este arquivo para
# .streamlit/secrets.toml e preencha com valores reais. O arquivo real
# NUNCA deve ser commitado (já está no .gitignore).
#
# storage_mode escolhe o backend de armazenamento: "local" (pasta
# sincronizada do OneDrive, só funciona no seu computador — recomendado
# pra rodar localmente, ver README), "digitalocean_spaces" (produção
# atual) ou "graph_api" (Microsoft Graph, mantido mas nunca testado com
# credenciais reais — ver modules/storage/graph.py). Detalhes de cada
# modo em modules/storage/__init__.py::get_storage_client.

storage_mode = "local"

[local]
raiz = "C:/Users/SeuUsuario/OneDrive - Sua Empresa/Mapa da Farmácia"

# --- Modo "digitalocean_spaces" (produção) — descomente e preencha, e
# troque storage_mode acima, quando for apontar pra produção. ---
# [digitalocean]
# access_key = "..."
# secret_key = "..."
# bucket = "..."
# endpoint_url = "https://nyc3.digitaloceanspaces.com"
# prefixo = ""

[api_lojas]
url = "https://exemplo.invalido/api/full-stores"
api_key = "..."

[auth]
senha = "defina-uma-senha-aqui"
