# Copie este arquivo para .streamlit/secrets.toml e preencha com os
# valores reais. O secrets.toml de verdade NUNCA deve ser commitado
# (já está no .gitignore).

# ---- Modo local (funciona sem aprovação de TI) ----
storage_mode = "local"

[local]
# Caminho absoluto até a pasta "Mapa da Farmácia" já sincronizada pelo
# OneDrive no computador onde o Streamlit está rodando.
raiz = "C:/Users/SeuUsuario/OneDrive - Rede Melhor Compra/14 - CONSULTOR INTERNO/01 - Dedicado/Mapa da Farmácia"


# ---- Modo Microsoft Graph API (requer aprovação de TI / Azure AD) ----
# storage_mode = "graph_api"
#
# [graph_api]
# tenant_id = "..."
# client_id = "..."
# client_secret = "..."
# drive_id = "..."


# ---- Modo DigitalOcean Spaces (backend principal a partir desta fase —
# compatível com S3, não depende de nenhum computador específico ligado).
# Ainda aguardando as credenciais reais do TI (bucket, endpoint, chaves);
# até lá, este bloco fica comentado e o app continua em storage_mode="local". ----
# storage_mode = "digitalocean_spaces"
#
# [digitalocean]
# access_key = "..."
# secret_key = "..."
# bucket = "..."
# # Endereço regional do Space — o formato é
# # "https://<regiao>.digitaloceanspaces.com" (ex.: "https://nyc3.digitaloceanspaces.com").
# # A região exata é definida quando o TI criar o bucket.
# endpoint_url = "https://nyc3.digitaloceanspaces.com"
# # Opcional: "subpasta" lógica dentro do bucket, só necessário se o mesmo
# # bucket vier a ser compartilhado com outro projeto. Deixe vazio/omitido
# # para usar a raiz do bucket inteira.
# prefixo = ""


# ---- Autenticação ----
# Senha única compartilhada entre os consultores — NÃO é um sistema
# multiusuário, é só uma proteção extra caso o link do app vaze. Todo
# mundo que sabe essa senha entra com o mesmo acesso.
[auth]
senha = "troque-esta-senha"
